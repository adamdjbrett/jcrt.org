---
issue: 
season: 
title: Table of Contents
description:
image: /img/jcrt.jpg
---

{% set current_dir = page.inputPath | replace('/index.njk', '/') %}
{% set issues = [] %}

{% for entry in collections.all %}
  {% if entry.inputPath and entry.inputPath.startsWith(current_dir) %}
    {% set relative_path = entry.inputPath | replace(current_dir, '') %}
    {% set relative_parts = relative_path.split('/') %}
    {% if relative_path.endsWith('/index.njk') and (relative_parts | length) == 2 %}
      {% set volume_key = (entry.data.volume|string).padStart(3, '0') %}
      {% set issue_key = (entry.data.issue|string).padStart(3, '0') %}
      {% set sort_key = volume_key + '.' + issue_key %}
      {% set issues = issues.concat([{
        entry: entry,
        sort_key: sort_key
      }]) %}
    {% endif %}
  {% endif %}
{% endfor %}

{% set sorted_issues = issues | sort(false, false, 'sort_key') | reverse %}

{% for issue_item in sorted_issues %}
  {% set issue_entry = issue_item.entry %}
  {% set issue_dir = issue_entry.inputPath | replace('/index.njk', '/') %}
  {% set issue_articles = [] %}

 <h2>
    {{ issue_entry.data.volume }}.{{ issue_entry.data.issue }} {{ issue_entry.data.season }} {% if issue_entry.data.title %} - {{ issue_entry.data.title }}{% endif %}
  </h2>

  {% for article in collections.all %}
    {% if article.inputPath and article.inputPath.startsWith(issue_dir) %}
      {% set article_relative = article.inputPath | replace(issue_dir, '') %}
      {% if article_relative.endsWith('.md') and article_relative != 'index.md' and '/' not in article_relative %}
        {% set issue_articles = issue_articles.concat([article]) %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {# Sort by sort_id if present, else by pages (first page), else last #}
  {% set sortable_articles = [] %}
  {% for article in issue_articles %}
    {% set sort_id = article.data.sort_id %}
    {% set pages = article.data.pages %}
    {% set pages_first = (pages or "").toString().split("-")[0].trim() %}
    {% set pages_num = pages_first.replace("S", "").replace("s", "").replace("P", "").replace("p", "").trim() %}
    {% set sort_key = (sort_id or pages_num or "999999").toString().padStart(6, "0") %}
    {% set sortable_articles = sortable_articles.concat([{ article: article, sort_key: sort_key }]) %}
  {% endfor %}

  {% set sorted_articles = sortable_articles | sort(false, false, "sort_key") %}

  {% for item in sorted_articles %}
    {% set article = item.article %}
    <h3>
      <a href="{{ article.url }}">{{ article.data.title or article.fileSlug }}</a>
    </h3>
    {% if article.data.author or article.data.affilation %}
      <p>
        {% if article.data.author %}{{ article.data.author }}{% endif %}
        {% if article.data.author and article.data.affilation %}<br>{% endif %}
        {% if article.data.affilation %}{{ article.data.affilation }}{% endif %}
      </p>
    {% endif %}
  {% endfor %}
{% endfor %}
