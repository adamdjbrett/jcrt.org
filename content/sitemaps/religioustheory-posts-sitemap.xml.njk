---
permalink: /sitemaps/religioustheory-posts-sitemap.xml
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/sitemaps/sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set lastUpdated = theory.lastUpdated or (page.inputPath | lastModifiedDate) -%}
	<url>
		<loc>{{ "/religioustheory/posts/" | htmlBaseUrl(metadata.url) }}</loc>
		{% if lastUpdated %}<lastmod>{{ lastUpdated | htmlDateString }}</lastmod>{% endif %}
		<priority>0.6</priority>
	</url>

{%- for post in (theory.posts or []) %}
	{%- if post.slug %}
		<url>
			<loc>{{ ("/religioustheory/posts/" ~ (post.slug | slugify) ~ "/") | htmlBaseUrl(metadata.url) }}</loc>
			{% if lastUpdated %}<lastmod>{{ lastUpdated | htmlDateString }}</lastmod>{% endif %}
			<priority>0.7</priority>
		</url>
	{%- endif %}
{%- endfor %}
</urlset>
