---
permalink: /sitemaps/image-sitemap.xml
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/sitemaps/sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set base = sitemapBaseUrl or metadata.url -%}
{%- for img in assets.images %}
	{% set absoluteUrl %}{{ (base ~ ((img.url | url) | htmlEntityDecode)) | xmlEscape | safe }}{% endset %}
	<url>
		<loc>{{ absoluteUrl }}</loc>
		{% set lm = img.path | lastModifiedDate %}
		{% if lm %}<lastmod>{{ lm | htmlDateString }}</lastmod>{% endif %}
		<priority>0.2</priority>
	</url>
{%- endfor %}
</urlset>
