---
permalink: /sitemaps/religioustheory/tags-sitemap.xml
layout: false
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="/sitemaps/sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set lastUpdated = theory.lastUpdated or (page.inputPath | lastModifiedDate) -%}
	{%- set base = sitemapBaseUrl or metadata.url -%}
	<url>
		<loc>{{ (base ~ ("/religioustheory/tags/" | url)) | xmlEscape | safe }}</loc>
		{% if lastUpdated %}<lastmod>{{ lastUpdated | htmlDateString }}</lastmod>{% endif %}
		<priority>0.2</priority>
	</url>

	{%- for tag in (religioustheory_taxonomy.tags or []) %}
		<url>
			<loc>{{ (base ~ (("/religioustheory/tags/" ~ (tag | slugify) ~ "/") | url)) | xmlEscape | safe }}</loc>
			{% if lastUpdated %}<lastmod>{{ lastUpdated | htmlDateString }}</lastmod>{% endif %}
			<priority>0.2</priority>
		</url>
	{%- endfor %}
	</urlset>
