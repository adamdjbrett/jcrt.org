---
layout: theory.njk
title: Tags & Categories Archive
permalink: /religioustheory/taxonomy/index.html
---

<div class="container-fluid">

 {% include "partials/nav_desktop.njk" %}
<h1 class="display-5 fw-bold mb-5 border-bottom pb-3">Digital Archive Index</h1>
   <div class="row">
    <div class="col-md-12 mb-5">
        <h3 class="h4 text-uppercase mb-4 fw-bold text-primary">Categories</h3>
        {% set allCats = theory.posts | categoryTheory | sort %}
        {% for cat in allCats %}
        <details class="mb-3 border-bottom pb-2">
            <summary class="d-flex justify-content-between align-items-center fw-bold cursor-pointer">
                {{ cat | capitalize }}
                <i class="fas fa-chevron-down small text-muted"></i>
            </summary>
            <div class="mt-3 ps-3 border-start">
                {% for post in theory.posts %}
                    {% if post.categories | hasCategoryTheory(cat) %}
                    <div class="mb-2">

                        <a href="/religioustheory/posts/{{ post.slug }}/" class="text-decoration-none text-secondary small hover-primary">

                            • {{ post.title }}
                        </a>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </details>
        {% endfor %}
    </div>

    <div class="col-md-12 mb-5">
        <h3 class="h4 text-uppercase mb-4 fw-bold text-primary">Tags</h3>
        {% set allTags = theory.posts | tagTheory | sort %}
        {% for tag in allTags %}
        <details class="mb-3 border-bottom pb-2">
            <summary class="d-flex justify-content-between align-items-center fw-bold cursor-pointer">
                #{{ tag | upper }}
                <i class="fas fa-chevron-down small text-muted"></i>
            </summary>
            <div class="mt-3 ps-3 border-start">
                {% for post in theory.posts %}
                    {% if post.tags | hasTagTheory(tag) %}
                    <div class="mb-2">

                        <a href="/religioustheory/posts/{{ post.slug }}/" class="text-decoration-none text-secondary small hover-primary">

                            • {{ post.title }}
                        </a>
                    </div>
                    {% endif %}
                {% endfor %}
            </div>
        </details>
        {% endfor %}
    </div>
</div>
</div>
