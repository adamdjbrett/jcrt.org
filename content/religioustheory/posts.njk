---
layout: theory.njk
pagination:
  data: theory.posts
  size: 10
  alias: postlist
permalink: "/religioustheory/posts/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber }}{% endif %}/"
---
<div class="container">
  <div class="row">
    <div class="col-md-10 mx-auto p-3 p-md-5">
    {% include "partials/nav_desktop.njk" %}
      <h1>Religious Theory Posts</h1>
      
<div class="col-md-12 p-3 p-md-5 border-top mt-5">
  <div class="row">
  {% for post in pagination.items %}
    <div class="col-md-6 p-3 p-md-4">
      <div class="img-zoom-container mb-3">
        <a href="/religioustheory/posts/{{ post.slug | slugify }}/">
          {% set currentImg = post.image if post.image and post.image != 'null' else '/img/se.jpg' %}
          <img src="{{ currentImg }}" 
               class="img-post rounded shadow-sm w-100" 
               alt="{{ post.title }}"
               style="aspect-ratio: 16/9; object-fit: cover;"
               onerror="this.src='/img/jcrt.jpg';">
        </a>
      </div>
      <h3 class="h5">
        <strong>
          <a class="text-decoration-none text-dark" href="/religioustheory/posts/{{ post.slug | slugify }}/">
            {{ post.title }}
          </a>
        </strong>
      </h3>
      <div class="mb-2">
       <span class="small text-pink">
  By 
  {% set authorPage = collections.authors | getAuthorObj(post.author) %}

  {% if authorPage %}
    <a href="{{ authorPage.url }}" class="text-pink text-decoration-none fw-bold">
      {{ post.authorData.name }}
    </a>
  {% else %}
    {{ post.authorData.name }}
  {% endif %}
</span>     
        <div class="mt-1">
          <p><small class="text-muted">{{ post.date | postDate }}</small></p>
          {% if post.categories %}
            <p class="small"><small>
            {% for cat in post.categories %}
              <a href="/religioustheory/categories/{{ cat | slugify }}/" class="small text-pink text-decoration-none fw-bold">
                {{ cat }}
              </a>
              {% if not loop.last %},{% endif %}
            {% endfor %}
            </small></p>
          {% endif %}
        </div>
      </div>
      <a href="/religioustheory/posts/{{ post.slug | slugify }}/" class="btn  btn-pink col-12">Read Post</a>
    </div>
  {% endfor %}
</div>

{% set totalPages = pagination.pages.length %}
{% set currentPage = pagination.pageNumber + 1 %}

{% if totalPages > 1 %}
<nav class="pagination-editorial border-top pt-5 mt-5 d-flex align-items-center justify-content-between px-md-5" role="navigation">
    
    <div class="d-flex align-items-center" style="flex: 1;">
        {% if pagination.href.previous %}
            <a href="{{ pagination.href.previous }}" class="btn-editorial-ghost me-3">← Newer</a>
        {% else %}
            <span class="page-info text-secondary fw-bold small">Page {{ currentPage }} of {{ totalPages }}</span>
        {% endif %}
    </div>

    
    <div class="text-center d-none d-md-block" style="flex: 1;">
        {% if pagination.href.previous and pagination.href.next %}
            <span class="page-info text-secondary fw-bold small">Page {{ currentPage }} of {{ totalPages }}</span>
        {% endif %}
    </div>

    <div class="text-end" style="flex: 1;">
        {% if pagination.href.next %}
            <a href="{{ pagination.href.next }}" class="btn-editorial-ghost">Older →</a>
        {% else %}
            {% if pagination.href.previous %}
                <span class="page-info text-secondary fw-bold small">Page {{ currentPage }} of {{ totalPages }}</span>
            {% endif %}
        {% endif %}
    </div>
</nav>
{% endif %}

</div>

    </div>
  </div>
</div>
