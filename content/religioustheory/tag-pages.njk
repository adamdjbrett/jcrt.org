---
layout: theory.njk
pagination:
  data: religioustheory_taxonomy.tags
  size: 1
  alias: tag
permalink: "/religioustheory/tags/{{ tag | slugify }}/index.html"
eleventyComputed:
  title: "Tag: {{ tag }}"
---

<article class="container mt-5">
  {% include "partials/nav_desktop.njk" %}
  <header class="mb-4 text-center">
    <h1 class="display-4 fw-bold serif-font">#{{ tag }}</h1>
    <p><a class="text-decoration-none" href="/religioustheory/tags/">All tags</a></p>
  </header>

  <div class="row justify-content-center">
    <div class="col-md-9">
      <ul>
        {%- for post in theory.posts %}
          {%- set t = post.tags or [] -%}
          {%- set c = post.categories or [] -%}
          {%- if (t and (tag in t)) or (c and (tag in c)) %}
            <li>
              <a href="/religioustheory/posts/{{ post.slug | slugify }}/">{{ post.title }}</a>
              {% if post.date %}<span class="text-muted small"> — {{ post.date | postDate }}</span>{% endif %}
            </li>
          {%- endif %}
        {%- endfor %}
      </ul>
    </div>
  </div>
</article>
