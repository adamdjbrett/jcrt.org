---js
const pagination = {
	data: "theory.posts",
	size: 1,
	alias: "category",
	before: function(posts) {
		const cats = [];
		const seen = {};
		for (const post of posts || []) {
			for (const c of post.categories || []) {
				if (!c || seen[c]) continue;
				seen[c] = true;
				cats.push(c);
			}
		}
		return cats.sort((a, b) => String(a).localeCompare(String(b)));
	},
};

const eleventyComputed = {
	layout: "theory.njk",
	title: data => `Category: ${data.category}`,
	permalink: function(data) {
		return `/religioustheory/categories/${this.slugify(data.category)}/`;
	},
};
---
<div class="col-md-10 mx-auto">
  {% include "partials/nav_desktop.njk" %}

  <h1>Category: {{ category }} <a href="/religioustheory/categories/" 
    class="btn btn-pink float-end">← Back to categories</a></h1>
  

  <div class="row">
   {% for post in theory.posts %}
  {% if post.categories and (category in post.categories) %}
    <div class="col-md-6 p-3 p-md-4">
      <div class="img-zoom-container mb-3">
        <a href="/religioustheory/posts/{{ post.slug }}/">
          {% set currentImg = post.image if post.image and post.image != 'null' else '/img/se.jpg' %}
          <img src="{{ currentImg }}" 
               class="img-post rounded shadow-sm w-100" 
               alt="{{ post.title }}"
               style="aspect-ratio: 16/9; object-fit: cover;"
               onerror="this.src='/img/jcrt.jpg';">
        </a>
      </div>
      
      <h3 class="h5">
        <strong>
          <a class="text-decoration-none text-dark" href="/religioustheory/posts/{{ post.slug }}/">
            {{ post.title }}
          </a>
        </strong>
      </h3>
      
      {% if post.authorData.name %}
        <p class="small text-pink mb-2">By {{ post.authorData.name }}</p>
      {% elif post.date %}
        <p class="small text-muted mb-2">({{ post.date | postDate }})</p>
      {% endif %}

    <a href="/religioustheory/posts/{{ post.slug }}/" 
    class="btn col-12 btn-pink">View Document</a>
    </div>
  {% endif %}
{% endfor %}
	</div>
</div>
