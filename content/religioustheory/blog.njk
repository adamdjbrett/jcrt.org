---
layout: theory.njk
title: Blog
permalink: /religioustheory/blog/index.html
---
<div class="col-md-10 mx-auto">
  {% include "partials/nav_desktop.njk" %}

  <h1>Blog</h1>
  <p>Complete listing of all {{ (theory.posts or []) | length }} posts from Religious Theory.</p>

  <ul>
    {%- for post in (theory.posts or []) -%}
      <li style="margin: 0.75rem 0;">
        <a href="/religioustheory/posts/{{ post.slug | slugify }}/">{{ post.title }}</a>
        {% if post.date %}<br><small>{{ post.date | readableDate }}</small>{% endif %}
      </li>
    {%- endfor -%}
  </ul>
</div>

