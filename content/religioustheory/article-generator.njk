---
layout: theory.njk
pagination:
  data: theory.posts
  size: 1
  alias: post
permalink: "/religioustheory/posts/{{ post.slug | slugify }}/index.html"
eleventyComputed:
  date: "{{ post.date }}"
---

     
<article class="container-fluid mt-5">
  {% include "partials/nav_desktop.njk" %}
  <div class="row justify-content-center">
    <div class="col-md-9">
      <header class="mb-5 text-center">
        <div class="mb-3">
          {% if post.categories %}
            {% for cat in post.categories %}
              <a href="/religioustheory/categories/{{ cat | slugify }}/" 
                 class="text-primary text-decoration-none text-uppercase small fw-bold mx-2 letter-spacing-2 hover-primary">
                 {{ cat }}
              </a>
            {% endfor %}
          {% endif %}
        </div>

        <h1 class="display-3 fw-bold serif-font mb-4 px-md-5">{{ post.title }}</h1>
        
        <div class="post-meta text-muted border-top border-bottom py-3 mx-md-5">
          <span class="text-uppercase small">Published: <strong>{{ post.date | postDate }}</strong></span>
          <span class="mx-3 d-none d-md-inline text-light">|</span>
          <span class="text-uppercase small">Author: <strong>{{ post.authorData.name or "Editors" }}</strong></span>
        </div>
      </header>

      {% if post.image and post.image != 'null' %}
      <div class="mb-5 text-center">
        <img src="{{ post.image }}" class="img-fluid w-100 border shadow-sm" alt="{{ post.title }}" style="max-height: 500px; object-fit: cover;">
      </div>
      {% endif %}

      <div class="entry-content editorial-text px-md-4">
        {{ post.content | md | safe }}
      </div>

      <footer class="mt-5 pt-5 border-top">
        <div class="row align-items-center">
          <div class="col-md-7 mb-3 mb-md-0">
            <span class="small text-muted text-uppercase fw-bold me-2">Filed under:</span>
            {% for tag in post.tags %}
              <a href="/religioustheory/tags/{{ tag | slugify }}/" class="badge bg-light text-dark border text-decoration-none me-1 hover-primary">#{{ tag }}</a>
            {% endfor %}
          </div>
          <div class="col-md-5 text-md-end">
            <a href="/religioustheory/posts/" class="btn-editorial text-decoration-none">← Back to Archive</a>
          </div>
        </div>
      </footer>
    </div>
  </div>
</article>

<style>
  .serif-font { font-family: 'Playfair Display', Georgia, serif; }
  .letter-spacing-2 { letter-spacing: 2px; }
  .editorial-text { font-size: 1.2rem; line-height: 1.9; color: #2c2c2c; text-align: justify; }
  .editorial-text p { margin-bottom: 1.8rem; }
  .editorial-text h2, .editorial-text h3 { font-family: 'Playfair Display', serif; margin-top: 3rem; font-weight: 800; }
  
  .btn-editorial {
    border: 2px solid #000;
    color: #000;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 10px 20px;
    letter-spacing: 1px;
    transition: 0.3s;
    display: inline-block;
  }
  .btn-editorial:hover { background: #000; color: #fff !important; }

  .hover-primary:hover { color: var(--editorial-pink) !important; }
</style>

