---
layout: theory.njk
title: Religious Theory
description: Digital archive for JCRT Theory, Culture, and Religion.
permalink: /religioustheory/index.html
---

<div class="col-md-10 mx-auto">

 {% include "partials/nav_desktop.njk" %}

  <header class="mt-3 mb-3">
    <h1>Religious Theory Archive</h1>
    <p style="color: #666; font-size: 1.1rem;">Digital archive for JCRT Theory, Culture, and Religion.</p>
    <div style="margin-top: 15px;">
        <span style="background: #e1e1e1; padding: 5px 15px; border-radius: 20px; font-size: 0.9rem;">
            Total Posts: <strong>{{ theory.posts.length }}</strong>
        </span>
    </div>
  </header>
  <hr/>

<section class="mt-5">
  <h2 class="ghost-heading mb-4">Latest Updates</h2>
  
  <div class="ghost-feed">
    {% for post in theory.posts.slice(0, 6) %}
      <article class="ghost-card mb-5 d-md-flex align-items-center">
        <div class="ghost-img-wrapper me-md-4 mb-3 mb-md-0" style="flex: 0 0 300px;">
          <a href="/religioustheory/posts/{{ post.slug }}/">
          <img src="{% if post.image and post.image != 'null' and post.image != '' %}{{ post.image }}{% else %}/img/default-theory.jpg{% endif %}" 
     alt="{{ post.title }}" 
     class="img-fluid rounded shadow-sm"
     style="width: 100%; height: 220px; object-fit: cover;"
     onerror="this.onerror=null;this.src='/img/jcrt.jpg';">
          </a>
        </div>

        <div class="ghost-content">
          <h3 class="h4 fw-bold mb-2">
            <a href="/religioustheory/posts/{{ post.slug }}/" class="text-decoration-none text-dark hover-pink">
              {{ post.title }}
            </a>
          </h3>
          <p class="text-muted small mb-2 text-uppercase fw-bold">
            {{ post.date | readableDate if post.date else "Recently Published" }} {% if post.author %} — By {{ post.author }}{% endif %}
          </p>
          <p class="text-secondary small">
            {{ post.excerpt | truncate(150) if post.excerpt else "Explore this latest article from our religious theory archive..." }}
          </p>
          <a href="/religioustheory/posts/{{ post.slug }}/" 
          class="text-pink fw-bold text-decoration-none small">
            Read Article &rarr;
          </a>
        </div>
      </article>
    {% endfor %}
  </div>

  <div class="text-center mt-4">
    <a href="/religioustheory/posts/" 
    class="btn btn-pink px-4 py-2 text-uppercase fw-bold" style="letter-spacing: 1px;">
      View All Articles
    </a>
  </div>
</section>

<style>
.ghost-heading { font-family: "Georgia", serif; border-bottom: 2px solid #000; display: inline-block; padding-bottom: 5px; }
</style>

</div>