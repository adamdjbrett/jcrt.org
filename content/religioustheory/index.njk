---
layout: theory.njk
title: Religious Theory
description: Digital archive for JCRT Theory, Culture, and Religion.
permalink: /religioustheory/index.html
---

<div class="container-fluid">

 {% include "partials/nav_desktop.njk" %}

  <header class="mt-3 mb-3">
    <h1><strong><span class="border-bottom border-4 border-primary pb-2">Religious Theory Archive</span></strong></h1>
<!--
    <p style="color: #666; font-size: 1.1rem;">Digital archive for JCRT Theory, Culture, and Religion.</p>
    <div style="margin-top: 15px;">
        <span style="background: #e1e1e1; padding: 5px 15px; border-radius: 20px; font-size: 0.9rem;">
            Total Posts: <strong>{{ theory.posts.length }}</strong>
        </span>
    </div>
    -->
  </header>

<section class="mt-5">  
  <div class="row mt-3 mb-3">
{% for post in theory.posts.slice(0, 6) %}
<div class="col-md-6 col-lg-4 p-3 small p-md-5"> 
    <div class="img-zoom-container rounded-4 shadow-sm mb-3" style="aspect-ratio: 16/9; overflow: hidden;">
        <a href="/religioustheory/posts/{{ post.slug }}/" title="{{ post.title }}">
            <img class="img-post img-fluid" 
                 style="width: 100%; height: 100%; object-fit: cover;" 
                 alt="{{ post.title }}" 
                 src="{% if post.image and post.image != 'null' %}{{ post.image }}{% else %}/img/default-theory.jpg{% endif %}"
                 onerror="this.onerror=null;this.src='/img/jcrt.jpg';">
        </a>
    </div>

    <h3 class="serif fw-bold h5">{{ post.title }}</h3>
    
    <p class="text-muted x-small text-uppercase fw-bold mb-2" style="font-size: 0.7rem;">
        {{ post.date | readableDate if post.date else "Recently Published" }} 
       {% if post.author %} — By {{ post.authorData.name or post.author }}{% endif %}
    </p>


    <p class="text-secondary">
        {{ post.excerpt | truncate(120) if post.excerpt else "Explore this latest article from our religious theory archive..." }}
    </p>

    <p><a href="/religioustheory/posts/{{ post.slug }}/" class="btn btn-primary px-4 py-2 fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">
        Learn More
    </a></p>
</div>
{% endfor %}
</div>

  <div class="col-12 p-3 p-md-5 text-center mt-4 mb-3">
    <a href="/religioustheory/posts/" 
    class="btn btn-primary px-4 py-2 text-uppercase fw-bold" style="letter-spacing: 1px;">
      View All Articles
    </a>
  </div>
</section>


</div>

