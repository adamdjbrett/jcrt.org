{
	"name": "jcrt",
	"version": "0.0.1",
	"description": "JCRT Project develop by Adam Dj Brett.",
	"type": "module",
	"scripts": {
		"kill": "rd /s /q _site",
		"start": "npx @11ty/eleventy --serve",
		"dev": "cross-env QUICK_DEV=1 NODE_OPTIONS=--max-old-space-size=8192 npx @11ty/eleventy --serve --incremental --port=4000",
		"build:local": "npx @11ty/eleventy",
		"build": "rm -rf _site && npx @11ty/eleventy && node _config/generate-redirects.js && npx pagefind --site _site",
		"clear": "rm -rf _site theory_data_cache.json .cache",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"build-ghpages": "rm -rf _site && npx @11ty/eleventy --pathprefix=/jcrt.org/ && node _config/generate-redirects.js",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/jcrt.org/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
		"validate:sitemaps": "python3 scripts/validate_sitemaps.py"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/adamdjbrett/jcrt.org.git"
	},
	"author": {
		"name": "Adam DJ Brett",
		"email": "info@adamdjbrett.com",
		"url": "https://adamdjbrett.com/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"overrides": {
		"minimatch": "^10.2.1",
		"glob": "^11.0.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.4",
		"@11ty/eleventy-plugin-rss": "^2.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.1",
		"cross-env": "^7.0.3",
		"luxon": "^3.6.1",
		"markdown-it": "^14.1.0",
		"markdown-it-attrs": "^4.3.1",
		"zod": "^3.25.67",
		"zod-validation-error": "^3.5.2"
	},
	"dependencies": {
		"@11ty/eleventy-fetch": "^5.1.1",
		"adm-zip": "^0.5.16",
		"eleventy-plugin-toc": "^1.1.5",
		"gray-matter": "^4.0.3",
		"js-yaml": "^4.1.0",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-table-of-contents": "^0.8.0",
		"pagefind": "^1.4.0"
	}
}
