 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Biblical scholars; Memory; Analogy; Recitation (Education); Bible. Psalms",
 pages     = "122-147",
 note      = "",
}

@article{8693448220121001,
 abstract  = "The author discusses how Aristotle's concept of hexis (commonly translated as "habit" or "disposition") and the doctrine of grace developed by St. Augustine, has influenced the writing of the "Rule for Children" a 17th-century treatise by Jacqueline Pascal, directress of the girls' school at the convent Port Royal des Champs. He explains that the pedagogical principles set forth in Pascal's Rule were aimed at cultivating children's souls so that they could persevere on the path of salvation.",
 author    = "COCHRANE, RICH",
 number    = "2",
 title     = "HEXIS AND GRACE: THE FORMATION OF SOULS AT PORT ROYAL AND ELSEWHERE.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/aad08460-5757-3c28-ade7-25e2be2151fc",
 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Grace (Theology); Salvation; Soul; Religious life of children; Aristotle, 384-322 B.C.; Pascal, Jacqueline",
 pages     = "148-162",
 note      = "",
}

@article{8693448320121001,
 abstract  = "The author discusses how the idea of intellectual emancipation developed in Jacques Rancière's book "The Ignorant Schoolmaster," and the concept of the brain's plasticity described by Catherine Malabou could serve as philosophical foundations for a radical pedagogy that takes as its starting point the intrinsic equality of human intelligence. He stresses the need for genuinely progressive teaching practices in a time when the commercialization of knowledge reinforces economic inequality.",
 author    = "CROCKETT, CLAYTON",
 number    = "2",
 title     = "PEDAGOGY AND RADICAL EQUALITY: RANCIÈRE'S IGNORANT SCHOOLMASTER.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/d5f0b146-4469-33db-ad08-b49746445bb1",
 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Intellect; Education; Equality; All Other Miscellaneous Schools and Instruction; Educational Support Services; Administration of Education Programs; Ignorant Schoolmaster: Five Lessons in Intellectual Emancipation, The (Book); Rancière, Jacques, 1940-",
 pages     = "163-173",
 note      = "",
}

@article{8693447720121001,
 abstract  = "The author describes how the ideas set forth by philosopher Jacques Rancière in his book "The Ignorant Schoolmaster," could provide the basis for an emancipatory framework of religious education. As an alternative to the traditional classroom setup in which the teacher serves as the supreme arbiter of a text's meaning, he proposes an image of the classroom as a translation workshop in which the teacher guides the student towards a more personal and creative engagement with religious texts.",
 author    = "BALLAN, JOSEPH",
 number    = "2",
 title     = "THE INTELLIGENCE OF THE BOOK: THE RELIGIOUS STUDIES CLASSROOM AS TRANSLATION WORKSHOP.",
