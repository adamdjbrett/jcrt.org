 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Religion in literature; Religious studies; Shaffer, Peter, 1926-2016; Derrida, Jacques, 1930-2004; Schechner, Richard, 1934-",
 pages     = "69-84",
 note      = "",
}

@article{8693448520121001,
 abstract  = "The author suggests that teaching Danish philosopher Søren Kierkegaard's 1832 book "Fear and Trembling" in the religious studies classroom could help both professors and students withstand the tendency to want ready-made answers to philosophical problems, which obscures the processes in which these answers are reached. He notes that the struggle between faith and doubt depicted by Kierkegaard resists easy integration into classroom activities aimed at the accumulation of empirical facts.",
 author    = "DICKINSON, T. WILSON",
 number    = "2",
 title     = "TEACHING WITH FEAR AND TREMBLING: THE TRIAL OF ABRAHAM, THE READER, AND THE PROFESSOR.",
 volume    = "12",
