@misc{8693449320121001,
 abstract     = "An interview with U.S. educator and philosopher of religion Mark C. Taylor on the continuing relevance of pedagogy in the 21st century is presented. Taylor observes that the existing model for university, first conceived by German philosopher Immanuel Kant, is becoming obsolete with the increasing cost of higher education. However, he believes that liberal arts education is more valuable than ever since it allows students to learn more about cultures and traditions different from their own.",
 author       = "TAYLOR, MARK C. and KOSKY, JEFFREY",
 title        = "RECALLING OUR VOCATION: A CONVERSATION ABOUT TEACHING WITH MARK C. TAYLOR.",
 url          = "https://research.ebsco.com/plink/1e83b2b9-6bf6-32dc-8ef0-118b0067bbb5",
 year         = "2012",
 keywords     = "Education; Universities & colleges; United States; All Other Miscellaneous Schools and Instruction; Educational Support Services; Administration of Education Programs; Colleges, Universities, and Professional Schools; Educators; Higher education; Taylor, Mark C.; Kant, Immanuel, 1724-1804",
 note         = "",
}

@misc{8693448020121001,
 abstract     = "An interview with theologian and philosopher of religion John D. Caputo is presented. Caputo proposes a new framework for education built on the concept of the "event," a philosophical term referring to the coming of something that can radically transform societies and institutions for the better or for worse, as an alternative to both the current information-driven model of the secular university and to the growing turn towards an approach that focuses on the religious formation of students.",
 author       = "CAPUTO, JOHN D. and DICKINSON, T. WILSON",
 title        = "EDUCATION AS EVENT: A CONVERSATION WITH JOHN D. CAPUTO.",
 url          = "https://research.ebsco.com/plink/5f3d048c-c900-31ec-b97c-1ff5e973dd01",
 year         = "2012",
 keywords     = "Education; Universities & colleges; Students; Religion; Administration of Education Programs; Educational Support Services; All Other Miscellaneous Schools and Instruction; Colleges, Universities, and Professional Schools; Caputo, John D.",
 note         = "",
}

@misc{8693448120121001,
 abstract     = "An interview with American theologian Sarah Coakley on how spiritual practices like silent prayer inform her pedagogical practice is presented. Coakley shares that while she tries to make time for silent prayer amidst her numerous teaching commitments, such practices must not be included as a requirement in theological courses. Citing George Steiner's comments on the eroticism inherent in the teacher-student relationship, she warns theology teachers to be on guard against self-aggrandizement.",
 author       = "COAKLEY, SARAH and JONES, TAMSIN",
 title        = "SILENCE, PRAYER, AND DESIRE IN PEDAGOGICAL PRACTICES: A CONVERSATION WITH SARAH COAKLEY.",
 url          = "https://research.ebsco.com/plink/4f64acd1-fea1-3eac-a4cb-aa36121011cb",
 year         = "2012",
 keywords     = "Prayer; Religious educators; Erotica; United States; American theologians; Coakley, Sarah, 1951-; Steiner, George, 1929-",
 note         = "",
}

@article{8693448720121001,
 abstract  = "The author presents his reflections on the three classical philosophical problems concerned with transcendence, meaningless suffering, and cosmology in terms of an "engaged philosophy of religion". He differentiates engaged philosophy from idealist philosophy, claiming that the latter attempts to explain phenomena in terms of an absolute, abstract truth divorced from material reality, while the former seeks to cultivate ethical reasoning drawn from actual relations and interactions with life.",
 author    = "GOODCHILD, PHILIP",
 number    = "2",
 title     = "ENGAGED PHILOSOPHY OF RELIGION.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/4b22b901-c65b-321b-a862-a691d83dd402",
 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Philosophy; Transcendence (Philosophy); Reasoning; Metaphysical cosmology; Suffering",
 pages     = "52-68",
 note      = "",
}

@article{8693449220121001,
 abstract  = "The author describes how the examination of the double bind of passion and resistance as performed in Peter Shaffer's play "Equus" can open up transformative pedagogical possibilities for the study of religion. He cites the performative theories of Jacques Derrida and Richard Schechner to explain how "Equus" dramatizes the complex imbrications of religious passions and critical resistances to them, especially as seen through the dynamic between its protagonists Alan Strang and Martin Dysart.",
 author    = "ROBERT, WILLIAM",
 number    = "2",
 title     = "PERFORMING RELIGIOUSLY BETWEEN PASSION AND RESISTANCE.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/672f8503-15bf-38df-a411-18a71e26835a",
