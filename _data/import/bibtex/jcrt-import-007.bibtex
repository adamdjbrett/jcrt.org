 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Religious education; Teachers; Religious literature; Students; Rancière, Jacques, 1940-",
 pages     = "174-186",
 note      = "",
}

@article{8693448820121001,
 abstract  = "The author looks at several models of ethnographic practices of fieldwork and writing and their possible contributions to religious studies. She notes that American anthropologist Clifford Geertz favored a cultural-interpretivist approach to ethnography, while French philosopher Michel de Certeau observes that the value of ethnographic writing lies in its re-inscription of alterity. She also mentions the "ethnography of things," which examines how material culture works to shape human activity.",
 author    = "HEO, ANGIE",
 number    = "2",
 title     = "THREE CLASSROOM READINGS OF 'ETHNOGRAPHIC PRACTICE' IN RELIGIOUS STUDIES.",
 volume    = "12",
 url       = "https://research.ebsco.com/plink/1403169d-8ede-31e8-b2c6-ca7e5205d635",
 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Ethnology; Material culture; Other (Philosophy); Geertz, Clifford, 1926-2006; Certeau, Michel de, 1925-1986",
 pages     = "187-195",
 note      = "",
}

@article{8693447820121001,
 abstract  = "The author calls for a re-conceptualization of the philosophical framework behind the pedagogical practice of service learning based on the theories of Paul Ricoeur, who emphasizes the role of narrative in the development of the ethical self. He argues that the preoccupation of most of the service learning literature with assessing the "moral development" of students does not sufficiently address the ethical challenges encountered by students in the very practice of service learning itself.",
 author    = "BLOSSER, JOE",
 number    = "2",
 title     = "BEYOND MORAL DEVELOPMENT: RE-THEORIZING ETHICAL PRACTICES IN SERVICE LEARNING.",
 volume    = "12",
