 year      = "2012",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "College students; Brazil; Transformative learning; Experiential learning; Active learning; Freire, Paulo, 1921-1997",
 pages     = "215-227",
 note      = "",
}

@article{8693448920121001,
 abstract  = "The author highlights how the act of translating the Bible has allowed Italian left-wing activist Erri de Luca to come into contact with an "I" who is a "stumbling-block over himself." She explains that although De Luca defines himself as a non-believer who initially rejected the New Testament as a deviation from the original Hebrew letter of the Old Testament, his personal reimagining of the life of Jesus gave him a new reference point for reflecting on his own philosophy and poetics.",
 author    = "MONTEL-HURLIN, ELISE",
 number    = "2",
 title     = "JESUS BEYOND CHRIST: ERRI DE LUCA AND THE "SELF AS STUMBLING BLOCK".",
