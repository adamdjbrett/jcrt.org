@article{10915080120150301,
 abstract  = "The article presents the author's views on philosopher Ludwig Feuerbach's opinion on religious conciousness in modern culture. Feuerbach's model of religious consciousness is explored which reportedly also demonstrates self-consciousness based on religious feeling. Other topics include the book "On Religion: Speeches to Its Cultured Despisers" by Friedrich Schleiermacher, the developments in religion and political philosophy studies, and debates in religious studies.",
 author    = "FLANAGAN-FEDDON, CHRISTY",
 number    = "2",
