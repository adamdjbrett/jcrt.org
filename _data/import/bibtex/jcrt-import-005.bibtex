@article{10915079320150301,
 abstract  = "The article examines the role of deep time in motivating epistemic humility with regard to humans' place in time. Modernism and postmodernism are discussed which are two forms of the philosophy and situates them within the philosophy of religion. An overview of deep time is provided and explores the positive and negative aspects of modernism and post modernism. Also tackled are pessimism and optimism, intellectual humility and consilience, and continental and analytic religious philosophy.",
 author    = "SCHELLENBERG, J. L.",
 number    = "2",
 title     = "A SHALLOW SPECIES IN DEEP TIME: MODERNISM, POSTMODERNISM, AND OUR PLACE IN THE POTENTIAL HISTORY OF INQUIRY.",
 volume    = "14",
 url       = "https://research.ebsco.com/plink/28baa17a-77c5-3fbb-ae68-4972b5f88fb8",
 year      = "2015",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Philosophy of religion; Modernism (Christian theology); Postmodernism (Philosophy); Pessimism; Deep time; Humility",
 pages     = "211-225",
 note      = "",
}

@misc{10915079420150301,
 abstract     = "An essay is presented on the philosophy of religion (PoR) with regard to two orientations to the subject. These orientations are the claim that the PoR's purpose is to promote a set of absolute moral norms and the claim that the field aims to determine whether religious communities' practices are true. Also explored are the tendency of the PoR to enable a thinking subject to make true claims, the mashup PoR, and the canon of modern PoR.",
 author       = "KAVKA, MARTIN",
 title        = "HUMANIZING PHILOSOPHY OF RELIGION: ON LANGUAGE IN LEVINAS AND SELLARS.",
 url          = "https://research.ebsco.com/plink/3279ad03-d67a-3b1a-b06f-6b739be3d4ad",
 year         = "2015",
 keywords     = "Philosophy of religion; Religious communities; Ethics; Theory of knowledge (Religion); Philosophy & religion; Religious humanism",
 note         = "",
}

@misc{10915079520150301,
 abstract     = "An essay is presented on the views of three philosophers on the relationship between being a linguistic agent and an ethical agent with regard to the philosophy of religion. These philosophers are Donald Davidson, Stanley Cavell, and Emmanuel Levinas. Other topics include how understanding language needs community conceptualization, the relationship between language and ethics, and skepticism.",
 author       = "SHUSTER, MARTIN",
 title        = "ON THE ETHICAL BASIS OF LANGUAGE: SOME THEMES IN DAVIDSON, CAVELL, AND LEVINAS.",
 url          = "https://research.ebsco.com/plink/a6f6325e-4fd3-30a1-8079-25ef89260432",
 year         = "2015",
 keywords     = "Language & languages; Philosophy of religion; Skepticism; Ethics; Davidson, Donald, 1917-2003; Cavell, Stanley, 1926-2018; Lévinas, Emmanuel, 1906-1995",
 note         = "",
}

@misc{10915079620150301,
 abstract     = "An essay is presented on modern English-language philosophy of religion (PoR) with regard to its possible mashup with other disciplines and as a specialized discussion within philosophy. Topics include critical thinking, a mousetrap analogy that supports the theory that a theistic God exists, and the need for PoR to be transformed and reject classical theism. Also discussed are typical introductory religious studies classroom and introductory approaches of books and scholarly journals.",
 author       = "LOEWEN, NATHAN R. B.",
 title        = "PROLEGOMENA TO ANY FUTURE MASHUPS WITH THE PHILOSOPHY OF RELIGION.",
 url          = "https://research.ebsco.com/plink/8021fe71-7c8b-35f9-a29a-ceea174d5e9f",
 year         = "2015",
 keywords     = "Philosophy of religion; Theism; Philosophy & religion; Critical thinking; God; Philosophy; Scholarly periodicals; Commercial Printing (except Screen and Books); Other printing; Periodical Publishers",
 note         = "",
}

@article{10915079720150301,
 abstract  = "The article examines mashups as a metaphor for conceptualizing philosophy of religion (PoR). The limitations of the mashup metaphor is explored as well as a critical inquiry method neglected by the mashup metaphor. It offers information on mashup music and proposes a metaphor that fosters productive thinking of PoR. Other topics include the diversity of religious phenomena, the analytic and continental modes of inquiry, and modern PoR.",
 author    = "KNEPPER, TIMOTHY D.",
 number    = "2",
 title     = "IS MASHUP THE RIGHT METAPHOR?",
 volume    = "14",
 url       = "https://research.ebsco.com/plink/c2994df7-ed1b-305c-82dc-2e4f34bf4c7a",
 year      = "2015",
 issn      = "15305228",
 journal   = "Journal for Cultural & Religious Theory",
 keywords  = "Philosophy of religion; Mashups (Musical form); Metaphor; Critical thinking; Philosophy & religion",
 pages     = "277-286",
 note      = "",
}

@article{10915079820150301,
 abstract  = "The article presents the author's views on the meta-philosophy of mash-up philosophy of religion (PoR) based on the concept of mashup music. He explores his experience of undertaking a meta-philosophical journey as well as the failure of mash-up philosophy to address issues facing philosophy. Other topics include the auditing culture, the use of neoliberal principles in higher education, and the need for modern philosophers to practice outide conventional institutional boundaries.",
 author    = "TRAKAKIS, N. N.",
 number    = "2",
 title     = "PHILOSOPHY MASHED-UP AND IN CRISIS.",
