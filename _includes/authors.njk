---
layout: jcrt/base.njk
---
<main class="container my-5">
    <div class="row">
        <aside class="col-lg-4 mb-5">
            <div class="bg-white p-4 rounded shadow-sm text-center border sticky-top" style="top: 2rem; z-index: 10;">
                <img src="{{ image or 'https://ui-avatars.com/api/?name=' ~ title ~ '&size=200&background=000&color=fff' }}" 
                     class="rounded-circle mb-4 shadow" 
                     width="150" height="150"
                     style="object-fit: cover;">
                
                <h2 class="serif fw-bold">{{ title }}</h2>
                
                {% if position %}
                <p class="text-muted small text-uppercase fw-bold border-bottom pb-3 mb-3">{{ position }}</p>
                {% endif %}
                
                <p class="text-secondary small mb-4">
                    {{ description or bio }}
                </p>
                
                <div class="d-flex justify-content-center gap-3">
                    {% if social %}
                        {% for s in social %}
                        <a href="{{ s.url }}" class="text-dark small text-decoration-none">
                            <i class="{{ s.icon or 'bi bi-link' }}"></i> {{ s.title }}
                        </a>
                        {% endfor %}
                    {% endif %}
                </div>
                            <p>
              {% if button %}
                {% for b in button %}
                  <a href="{{ b.url }}" class="btn btn-outline-dark me-2">{{ b.title }}</a>
                {% endfor %}
              {% endif %}
            </p>
            </div>
        </aside>

    
<div class="col-lg-8 ps-lg-5">
    {% set authorKey = page.fileSlug %}
    {% set postsByAuthor = collections.posts | getPostsByAuthor(authorKey) %}
    
    
    <h3 class="serif fw-bold mb-4 border-bottom pb-2">Articles by {{ title }}</h3>
    
    <div class="row g-4">
        {% if postsByAuthor.length %}
            {% for post in postsByAuthor | reverse %}
            <div class="col-md-6">
                <div class="news-card h-100 bg-white border">
                    {% if post.data.image %}
                    <img src="{{ post.data.image }}" class="card-img-top" alt="{{ post.data.title }}" style="height: 200px; object-fit: cover;">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="serif fw-bold h6">
                            <a href="{{ post.url }}" class="text-dark text-decoration-none stretched-link">
                                {{ post.data.title }}
                            </a>
                        </h5>
                        <p class="small text-muted mb-0">{{ post.date | postDate }}</p>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div class="col-12">
                <p class="text-muted italic">No publications found yet.</p>
            </div>
        {% endif %}
    </div>
</div>
    </div>
</main>