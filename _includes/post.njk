---
layout: jcrt/base.njk
---
<article class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-9 bg-white shadow-sm rounded-bottom overflow-hidden">
            
            <div class="p-4 p-md-5 text-center border-bottom">
                {% if tags %}
                <span class="text-uppercase text-muted small fw-bold spacing-1">
                    {{ tags | filterTagList | first }}
                </span>
                {% endif %}
                
                <h1 class="display-5 serif fw-bold my-3">{{ title }}</h1>
                
                <div class="d-flex justify-content-center align-items-center mt-4">
                    {% if author %}
                        {% set authorList = author if author is iterable and author is not string else [author] %}
                        {% for aKey in authorList %}
                            {% set authorData = collections.authors | getAuthorObj(aKey) %}
                            {% if authorData %}
                                <div class="d-flex align-items-center me-3">
                                    <img src="{{ authorData.data.image or jcrt.image }}" class="rounded-circle me-2" width="40" height="40" alt="{{ authorData.data.name }}">
                                    <div class="text-start">
                                        <h6 class="mb-0 fw-bold">{{ authorData.data.name or authorData.data.title }}</h6>
                                        {%if date %}<small class="text-muted">{{ date | postDate }}</small>{% endif %}
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <div class="text-start">
                            <h6 class="mb-0 fw-bold">Admin</h6>
                            {%if date %}<small class="text-muted">{{ date | postDate }}</small>{% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if image %}
            <div class="post-featured-image">
                <img src="{{ image }}" class="img-fluid w-100" alt="{{ title }}">
            </div>
            {% endif %}

            <div class="p-4 p-md-5 serif fs-5 post-body">
                {% if description %}
                    <p class="lead mb-4">{{ description }}</p>
                {% endif %}

                {{ content | safe }}

                {% if button %}
                <div class="mt-5">
                    {% for b in button %}
                        <a href="{{ b.url }}" class="btn btn-pink me-2 text-white">{{ b.title }}</a>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            {% if tags or author %}
            <div class="p-4 p-md-5 border-top bg-light">
                {% if tags %}
                <div class="mb-4">
                    <p class="small fw-bold text-muted text-uppercase mb-2">Tags</p>
                    {% for tag in tags | filterTagList %}
                        <a href="/tags/{{ tag | slugify }}/" class="btn btn-sm btn-outline-secondary me-1 mb-1">{{ tag }}</a>
                    {% endfor %}
                </div>
                {% endif %}

                {% if author %}
                <div class="row g-4 mt-2">
                    {% set authorList = author if author is iterable and author is not string else [author] %}
                    {% for aKey in authorList %}
                        {% set authorData = collections.authors | getAuthorObj(aKey) %}
                        {% if authorData %}
                        <div class="col-md-6">
                            <div class="d-flex align-items-center p-3 border rounded bg-white">
                                <img src="{{ authorData.data.image or jcrt.image }}" class="rounded-circle me-3" width="60" height="60">
                                <div>
                                    <h6 class="mb-1 fw-bold">{{ authorData.data.name }}</h6>
                                    <p class="small text-muted mb-1">{{ authorData.data.description | truncate(60) }}</p>
                                    <a href="{{ authorData.url }}" class="small text-pink text-decoration-none">Profile →</a>
                                </div>
                            </div>
                        </div>
                        {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endif %}

            {% set previousPost = collections.posts | getPreviousCollectionItem %}
            {% set nextPost = collections.posts | getNextCollectionItem %}
            {% if nextPost or previousPost %}
            <div class="border-top p-4 bg-dark d-flex justify-content-between">
                {% if previousPost %}
                <a href="{{ previousPost.url }}" class="btn btn-outline-light btn-sm text-start" style="max-width: 45%;">
                    <small class="d-block text-light">← Previous</small>
                    <span class="fw-bold d-none d-md-inline small">{{ previousPost.data.title }}</span>
                </a>
                {% else %}
                <div></div>
                {% endif %}

                {% if nextPost %}
                <a href="{{ nextPost.url }}" class="btn btn-outline-light btn-sm text-end" style="max-width: 45%;">
                    <small class="d-block text-light">Next →</small>
                    <span class="fw-bold d-none d-md-inline small">{{ nextPost.data.title }}</span>
                </a>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
</article>