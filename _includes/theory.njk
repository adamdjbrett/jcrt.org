<!DOCTYPE html>
<html lang="{{ metadata.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>{{ title || page.title || metadata.title }}</title>
  <meta name="description" content="{{ description || metadata.description }}">
  
  <!-- Open Graph / Twitter -->
  <meta property="og:title" content="{{ title || page.title || metadata.title }}">
  <meta property="og:description" content="{{ description || metadata.description }}">
  <meta property="og:image" content="{{ image || metadata.image }}">
  <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title || page.title || metadata.title }}">
  <meta name="twitter:description" content="{{ description || metadata.description }}">
  <meta name="twitter:image" content="{{ image || metadata.image }}">
  
  <link rel="icon" href="{{ metadata.favicon }}" type="image/x-icon">
  <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">
  
  <!-- CSS -->
  <style>{% include "css/bs.css" %}</style>
  <style>{% getBundle "css" %}</style>
  <link href="/css/index.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" rel="stylesheet">
  
  <!-- JSON-LD Simplified -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ metadata.title }}",
    "url": "{{ metadata.url }}"
  }
  </script>
</head>
<body>
  {% include "partials/sidebar.njk" %}
  <div id="content-wrapper" class="mse">
    {% include "partials/nav_mobile.njk" %}
    {{ content | safe }}
  </div>
  <script src="/js/bs.js"></script>
</body>
</html>
