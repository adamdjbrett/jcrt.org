---
layout: jcrt/base.njk
---
<main class="container my-5">
    <div class="text-center mb-5">
        <h1 class="serif fw-bold">{{ title or "Our Contributors" }}</h1>
        <p class="text-secondary">Scholars and thinkers behind the Journal of Critical Religious Theory</p>
    </div>

    <div class="row g-4">
        {% for a in collections.authors %}
        <div class="col-md-4 col-sm-6">
            <div class="news-card text-center p-4 h-100 bg-white shadow-sm border">
                <img src="{{ a.data.image or 'https://ui-avatars.com/api/?name=' ~ a.data.name ~ '&background=000&color=fff' }}" 
                     class="rounded-circle mb-3 shadow-sm" 
                     width="120" height="120" 
                     style="object-fit: cover;"
                     alt="{{ a.data.name }}">
                
                <h4 class="serif fw-bold mb-1">{{ a.data.name or a.data.title }}</h4>
                
                {% if a.data.position %}
                <p class="small text-muted mb-3 text-uppercase fw-bold spacing-1">{{ a.data.position }}</p>
                {% endif %}
                
                {% if a.data.description %}
                <p class="small text-secondary mb-4">{{ a.data.description | truncate(90) }}</p>
                {% endif %}
                
                <a href="{{ a.url }}" class="btn btn-outline-dark btn-sm px-4">View Profile</a>
            </div>
        </div>
        {% endfor %}
    </div>
</main>