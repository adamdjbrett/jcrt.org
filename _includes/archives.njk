---
layout: base.njk
---
<div class="col-md-10 mx-auto">
  {% include "partials/nav_desktop.njk" %}

  <div class="container-fluid">
    <article class="py-4">
      <header class="mb-5 border-bottom pb-4">
        {% if article_number %}
          <div class="text-pink fw-bold small text-uppercase mb-2">Article No. {{ article_number }}</div>
        {% endif %}

        <h1 class="serif fw-bold display-4">{{ jsonEntry.title or title }}</h1>
        
        <div class="text-muted mb-3">
          <i class="bi bi-person-fill"></i>
          <span class="fw-bold text-dark">{{ jsonEntry.author or author }}</span>
          {% if affilation %}<br><small class="text-muted">{{ affilation }}</small>{% endif %}
        </div>

        <div class="d-flex flex-wrap gap-3 align-items-center small">
          {% set displayDate = jsonEntry.date or date %}
          {% if displayDate %}
            <span><i class="bi bi-calendar3"></i> {{ displayDate | postDate }}</span>
          {% endif %}
          
          {% if pdfUrl %}
            <a href="{{ pdfUrl }}" class="btn btn-sm btn-outline-danger px-3 shadow-sm" target="_blank">
              <i class="bi bi-file-earmark-pdf"></i> Download PDF
            </a>
          {% endif %}
        </div>
      </header>

      {% if abstract %}
      <section class="abstract mb-5 p-4 bg-light border-start border-4 border-primary">
        <h5 class="fw-bold text-uppercase small text-primary">Abstract</h5>
        <div class="serif italic">{{ abstract | markdownify | safe }}</div>
      </section>
      {% endif %}

      <div class="article-body serif lh-lg" style="font-size: 1.15rem; text-align: justify;">
       <div class="p-3 bg-light">
        {{ content | toc | safe }}
       </div>       
        {{ jsonEntry.content | markdownify | safe if jsonEntry.content else content | safe }}
      </div>

      {% if tags.length > 0 %}
      <footer class="mt-5 pt-3 border-top">
        <div class="d-flex gap-2 align-items-center">
          <span class="small text-muted text-uppercase fw-bold">Keywords:</span>
          {% for tag in tags %}
            <span class="badge bg-secondary-subtle text-secondary border fw-normal">{{ tag }}</span>
          {% endfor %}
        </div>
      </footer>
      {% endif %}
    </article>
  </div>
</div>