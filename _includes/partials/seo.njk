<title>{{title or metadata.title}}</title>
<meta content="{{title or metadata.title}}" property="og:title" />
<meta content="{{title or metadata.title}}" property="dc:title" />
<meta content="{{title or metadata.title}}" name="twitter:title" />
<meta content="{{title or metadata.title}}" name="title" />
<meta content="{{title or metadata.title}}" property="og:site_name" />
<meta content="{{description or metadata.description}}" name="description" />
<meta
	content="{{description or metadata.description}}"
	property="facebook:description"
/>
<meta
	content="{{description or metadata.description}}"
	property="og:description"
/>
<meta
	content="{{description or metadata.description}}"
	name="twitter:description"
/>
<meta property="twitter:card" content="summary_large_image" />
<meta content="{{image or metadata.image}}" name="twitter:image" />
<meta content="{{image or metadata.image}}" name="facebook:image" />
<meta content="{{image or metadata.image}}" name="og:image" />
<link href="{{ metadata.favicon }}" rel="icon" type="image/x-icon" />
<link rel="apple-touch-icon" href="{{ metadata.favicon }}" />
<meta content="{{ metadata.metasocial.facebook }}" property="facebook:author" />
<meta
	content="{{ metadata.metasocial.twitteruser }}"
	property="twitter:author"
/>
<meta property="dc:creator" content="{{ metadata.author.name }}" />
<meta content="{{ metadata.metasocial.twitter }}" name="twitter:site" />
<meta property="og:type" content="website" />
<meta content="index, follow" name="robots">
<link rel="canonical" href="{{ metadata.url }}{{ page.url }}" />
<link
	rel="alternate"
	href="feed/feed.xml"
	type="application/atom+xml"
	title="{{ metadata.title }}"
/>
<meta name="language" content="{{ metadata.language }}" />
<meta name="locale" content="{{ metadata.locale }}" />
<meta property="og:locale" content="{{ metadata.locale }}" />
<meta name="generator" content="{{ eleventy.generator }}" />
<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
<style>{% include "css/bs.css" %}</style>
<style>{% getBundle "css" %}</style>
<link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,300i,600,600i" rel="stylesheet">
<link href="/css/index.css" rel="stylesheet"/>
<link href="/css/font.css" rel="stylesheet"/>
{% set pageTitle = title or pg.title or post.title or metadata.title %}
{% set pageDesc = description or pg.excerpt or post.excerpt or metadata.description %}
{% set pageImage = image or metadata.image %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ pageTitle }}",
  "description": "{{ pageDesc | truncate(160) }}",
  "image": "{{ pageImage }}",
  "datePublished": "{{ date | isoDate if date else metadata.buildTime }}",
  "dateModified": "{{ date | isoDate if date else metadata.buildTime }}",
  "author": {
    "@type": "Person",
    "name": "{{ author or pg.authorName or post.authorName or metadata.author.name }}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ metadata.title }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ metadata.url }}{{ metadata.favicon }}"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ metadata.url }}{{ page.url }}"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ metadata.url }}"
    },
    {% if pg or post %}
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Religious Theory",
      "item": "{{ metadata.url }}/religioustheory/"
    },
    {% endif %}
    {
      "@type": "ListItem",
      "position": {{ 3 if (pg or post) else 2 }},
      "name": "{{ pageTitle }}",
      "item": "{{ metadata.url }}{{ page.url }}"
    }
  ]
}
</script>