<div class="row">
{%- for post in postslist | reverse %}
    <div class="col-md-4 p-3">
        <h3><a href="{{ post.url }}" class="postlist-link">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a></h3>
        <p>{{ post.data.description }}</p>
        {% if post.data.tags %}
        <div class="mt-2">
            {%- for tag in post.data.tags | filterTagList %}
                {%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
                <a href="{{ tagUrl }}" class="badge bg-light text-secondary text-decoration-none me-1">#{{ tag }}</a>
            {%- endfor %}
        </div>
        {% endif %}
    </div>
{%- endfor %}
</div>